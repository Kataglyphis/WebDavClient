# LF whatever core.autocrlf says: a CR from a Windows checkout becomes part of a bash token.
*.sh    text eol=lf
*.bash  text eol=lf

# Ratchet freeze files are read by the hub's gates in the Linux container; LF keeps them safe by construction.
*.allow text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Exclude vendored trees from language analysis
third_party/** linguist-vendored
