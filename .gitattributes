# Shell scripts MUST be LF regardless of anyone's core.autocrlf. They run only
# inside the Linux CI container, and a lone CR from a Windows checkout makes
# bash read `\r` as part of a token - `set: pipefail\r: invalid option name`,
# or "$'\r': command not found" with exit 127 - which looks like a missing tool
# but is a line-ending fault. Git already stores these as LF; this makes the
# guarantee explicit so a Windows checkout cannot produce a CRLF working copy
# that fails locally while CI stays green.
*.sh    text eol=lf
*.bash  text eol=lf

# The ratchet freeze files, for the same reason: they are read only by the
# hub's Python gates, which run in the Linux container over this working copy.
# The parsers strip each line, so a CR would not actually break them today -
# the rule is here so that stays true by construction rather than by luck.
*.allow text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# exclude vendored trees from language analysis
third_party/** linguist-vendored
